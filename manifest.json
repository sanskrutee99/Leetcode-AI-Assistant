{
    "manifest_version": 3,
    "name": "LeetCode AI Assistant",
    "version": "1.0",
    "description": "AI assistant for solving LeetCode problems",
    "permissions": ["activeTab", "scripting"],
    "host_permissions": [
      "http://127.0.0.1:3000/*"
    ],
    "content_scripts": [
      {
        "matches": ["https://leetcode.com/problems/*"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ],
    "action": {
      "default_popup": "popup.html"
    }
  }