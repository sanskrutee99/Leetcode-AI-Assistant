{
  "manifest_version": 3,
  "name": "LeetCode AI Assistant",
  "version": "1.4.1",
  "description": "AI assistant for LeetCode problems using your Groq API key",
  "permissions": ["storage"],
  "host_permissions": ["https://api.groq.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeetCode AI Assistant"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": [
        "shared/storage.js",
        "shared/groq.js",
        "shared/constants.js",
        "shared/problemContext.js",
        "shared/chat.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
